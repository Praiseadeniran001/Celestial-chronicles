WHEELS = make_collection("CAR_WHEELS")
LIGHTS = make_collection("CAR_LIGHTS")
INTERIOR = make_collection("CAR_INTERIOR")
DETAILS = make_collection("CAR_DETAILS")


def move_to_collection(obj, collection):
    for c in list(obj.users_collection):
        c.objects.unlink(obj)

    collection.objects.link(obj)


