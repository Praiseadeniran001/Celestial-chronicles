def create_wheel(side, y, index):

    x = side * 1.78

    # Tire
    tire = torus(
        f"Wheel_{index}_Tire",
        (x, y, 0.83),
        0.62,
        0.24,
        RUBBER,
        rotation=(math.radians(90), 0, 0),
        collection=WHEELS
    )

    # Rim
    rim = cylinder(
        f"Wheel_{index}_Rim",
        (x, y, 0.83),
        0.45,
        0.18,
        RIM,
        rotation=(math.radians(90), 0, 0),
        collection=WHEELS,
        vertices=32,
        bevel=0.035
    )

    # Hub
    cylinder(
        f"Wheel_{index}_Hub",
        (x + side * 0.11, y, 0.83),
        0.12,
        0.22,
        CHROME,
        rotation=(math.radians(90), 0, 0),
        collection=WHEELS,
        vertices=20
    )

    # Spokes
    for spoke in range(5):

        angle = math.radians(spoke * 72)

        spoke_x = x + side * 0.12
        spoke_y = y + math.cos(angle) * 0.27
        spoke_z = 0.83 + math.sin(angle) * 0.27

        spoke_obj = cube(
            f"Wheel_{index}_Spoke",
            (spoke_x, spoke_y, spoke_z),
            (0.06, 0.20, 0.035),
            RIM,
            bevel=0.025,
            collection=WHEELS
        )

        spoke_obj.rotation_euler[0] = math.radians(90)
        spoke_obj.rotation_euler[1] = angle

    return tire


